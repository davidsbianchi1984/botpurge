# Copy to deploy/.env on the server (never commit the real one) and fill in.
BOTPURGE_PUBLIC_URL=https://www.botpurge.online
BOTPURGE_BETA=1                        # 1 = every plan free during the beta; 0 = paid plans
BOTPURGE_ADMIN_TOKEN=change-me-to-a-long-random-string

# Stripe (Developers > API keys; webhook: https://www.botpurge.online/api/billing/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# From: python -m botpurge.billing keygen  (the private half stays here only)
BOTPURGE_LICENSE_PRIVATE=

# Email from your IONOS mailbox (sends lost license keys). @ in the address is written %40.
BOTPURGE_SMTP_URL=smtps://david%40botpurge.online:YOUR-MAILBOX-PASSWORD@smtp.ionos.com:465
BOTPURGE_MAIL_FROM=Bot Purge <david@botpurge.online>

# Optional sign-ins (each needs https://www.botpurge.online/... as its redirect address)
X_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
